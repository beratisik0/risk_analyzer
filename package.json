{
  "name": "tos-risk-analyzer",
  "version": "1.0.0",
  "description": "Chrome Extension - Kullanım Koşulları ve Gizlilik Politikası Risk Analizcisi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "eval": "tsx eval/run-eval.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "openai": "^4.74.5",
    "zod": "^3.24.0",
    "page-agent": "^0.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "cypress": "^13.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^2.2.0"
  }
}